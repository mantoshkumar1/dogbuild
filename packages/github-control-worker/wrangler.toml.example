# Example only. Copy to wrangler.toml locally; never commit real values.
# Secrets are set with `wrangler secret put <NAME>` and never live in this file.
#
#   GITHUB_TOKEN        machine-identity token, repo-scoped to the allowlist
#   MCP_PATH_SECRET     path segment gating /mcp/<secret>
#   ALLOWED_REPOS       REQUIRED. e.g. "mantoshkumar1/pingstep,mantoshkumar1/dogbuild"
#                       Unset or malformed denies every repository.
#   ROLE_ASSERTION_KEY  HMAC key DogBuild signs request-scoped role assertions with.
#                       Unset means no role can be granted: reads only.
#   ROLE_TRANSPORT      REQUIRED for any write. Names the transport whose caller
#                       identity this Worker trusts. Only "dogbuild-signed-request"
#                       is recognised. Unset (the default) means every presented
#                       assertion is IGNORED and the server is read-only — a
#                       signed token on an untrusted transport is a bearer
#                       credential, not an identity. Do not set this until a
#                       trusted identity path actually exists; see the README's
#                       CAPABILITY_BLOCKED_ROLE_TRANSPORT note.
#   PROJECT_TOKEN       optional, isolated Projects-v2 credential. Never used
#                       for general GitHub operations.
#   OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET   connector handshake only.

name = "dogbuild-github-control-worker"
main = "src/index.js"
compatibility_date = "2026-08-01"
